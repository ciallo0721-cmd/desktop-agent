# 不进版本库的东西

.venv/
__pycache__/
*.pyc
*.pyo

# 本地配置里有 API Key，绝对不要提交
data/config.json

# 运行期数据
prompt/memory.md
data/conversations/*
!data/conversations/.gitkeep
data/backup/
data/trash/
data/tmp/
data/screenshots/*
!data/screenshots/.gitkeep
# 用户发进来的图片：可能含隐私，一个都不进库
data/images/
data/agent.log
data/crash.log
data/tui.log

# agent 的干活目录，内容随任务变
workspace/*
!workspace/.gitkeep

# 会话记录
.workbuddy/
